{
  "name": "export_preview",
  "description": "将当前文档的每一页导出为 PNG 预览图，尺寸 2000x2000，透明背景。文件名自动追加 _preview.png，返回总页数。",
  "inputSchema": {
    "type": "object",
    "properties": {
      "preview_src": {
        "type": "string",
        "description": "目录路径（以斜杠或反斜杠结尾），例如 C:\\preview\\"
      },
      "ver": {
        "type": "string",
        "description": "CorelDRAW 主版本号"
      }
    },
    "required": ["preview_src", "ver"]
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "code": {
        "type": "integer",
        "description": "状态码，200 表示成功"
      },
      "msg": {
        "type": "string",
        "description": "提示信息"
      },
      "data": {
        "type": "object",
        "properties": {
          "page_count": {
            "type": "integer",
            "description": "导出的总页数"
          }
        },
        "required": ["page_count"]
      }
    },
    "required": ["code", "msg", "data"]
  }
}